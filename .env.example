# Supabase (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# JWT signing secret — REQUIRED in production (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-long-random-string

# Common password auto-assigned to every new faculty account (optional; has a default)
FACULTY_DEFAULT_PASSWORD=freshers@3128

# Admin account used by supabase/seed.js
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
